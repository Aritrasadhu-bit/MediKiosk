# ---------------------------------------------------------------------------
# MediKiosk server-side configuration. Copy to .env.local (or set in the
# container/Docker Compose / CI environment) before starting the server.
# ---------------------------------------------------------------------------

# Authentication — signs the staff session cookie AND derives the key that
# encrypts PHI at rest. There is intentionally NO working default here: the
# server refuses to sign anything in production unless this is set to a real
# value of at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Left empty on purpose. Any value that still looks like a template
# ("replace-me", "your-secret", "CHANGE_ME", a run of x's) is rejected in
# production just as firmly as an empty value, so a deployment that copies this
# file without editing it fails to start instead of running with a public key.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Hospital Information System / EMR push (optional)
# ---------------------------------------------------------------------------
# off (default) records the delivery attempt as "not configured" and says so in
# the UI. Set one of the two real transports below to actually send the record.
# Either way, a push only happens when the patient ticked the
# "Send it to this hospital's information system" consent box; without that the
# attempt is logged as blocked for lack of consent.
#
# MEDIKIOSK_HIS_MODE=fhir
# MEDIKIOSK_HIS_FHIR_URL=https://his.example.org/fhir/r4

# MEDIKIOSK_HIS_MODE=hl7v2
# MEDIKIOSK_HIS_HL7_HOST=10.0.0.5
# MEDIKIOSK_HIS_HL7_PORT=2575

# ---------------------------------------------------------------------------
# ABDM live gateway (optional — sandbox-local simulation is the default)
# ---------------------------------------------------------------------------
# Out of the box every ABDM payload is built in the documented NDHM wire
# format but nothing leaves the hospital (responses report delivered:false).
# To submit for real through a hospital gateway bridge:
#   1. Register the facility on the ABDM sandbox (https://sandbox.abdm.gov.in),
#      complete HIP onboarding, and obtain bridge credentials.
#   2. Deploy a thin bridge adapter in front of the NDHM gateway APIs exposing
#      two endpoints the app calls (see src/lib/server/abdmClient.ts):
#        POST <bridge>/verify-health-id   { abhaId, hipId } -> { valid, reason }
#        POST <bridge>/consent-request    { <consent manuscript> } -> { ok, gatewayConsentId?, status? }
#   3. Set the five values below. Any failure (unreachable, non-2xx, timeout)
#      falls back to the local artefacts — a live outage never blocks care.
# ABDM_GATEWAY_MODE=live
# ABDM_BRIDGE_URL=https://bridge.hospital.example/abdm
# ABDM_CLIENT_ID=
# ABDM_CLIENT_SECRET=
# ABDM_HIP_ID=SBX-HIP-MEDIKIOSK-100001
# ABDM_TIMEOUT_MS=15000

# Optional — override the LLM used for summarization/extraction and its timeout.
# MEDIKIOSK_OPENAI_MODEL=gpt-4o-mini
# MEDIKIOSK_LLM_TIMEOUT_MS=20000

# Optional — enables LLM-backed medical document extraction, history summarization,
# and conversational AI follow-up questions. All core features work offline without
# this key using the built-in rules engine.
OPENAI_API_KEY=

# Optional — Indian English/multilingual speech-to-text backend (Bhashini / AI4Bharat).
# Without these, the app falls back to the browser's Web Speech API (Chrome/Edge).
# Option A: full AI4Bharat ASR URL
AI4BHARAT_ASR_URL=
# Option B: Bhashini pipeline (recommended — enables Indian languages incl. Hindi, Tamil, Telugu)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_ASR_MODEL_ID=

# Server persistence — JSON-file store lives here (relative to the project root).
# Also holds the auto-generated development-only signing secret
# (<MEDIKIOSK_DATA_DIR>/.dev-session-secret) when SESSION_SECRET is unset, so
# that route handlers and the proxy agree on one key across restarts.
# Swap `src/lib/server/db.ts` for a SQLite/Postgres adapter for larger deployments.
MEDIKIOSK_DATA_DIR=data

# Storage engine — JSON-file store vs SQLite (Node's built-in node:sqlite,
# no native deps; needs Node >= 22.5).
#
# When unset: a FRESH data dir takes SQLite automatically; a dir that already
# holds encounters.json keeps using JSON so live data is never orphaned.
# Rule of thumb: JSON is fine for demos and single-kiosk pilots (dozens of
# patients/day). Anything bigger — concurrent kiosks, hundreds/day — wants
# SQLite (WAL journaling, indexed reads, no full-file rewrite per write).
#
# Pin explicitly when it matters:
# MEDIKIOSK_DB=sqlite   (production — falls back to JSON with a loud warning
#                        if node:sqlite is unavailable)
# MEDIKIOSK_DB=json     (force the file store, e.g. to keep tooling simple)
#
# Migrating an existing JSON store: stop the server, then run
#   npm run migrate:json-sqlite [-- --data-dir=./data] [--dry-run]
# The merge is idempotent and never deletes the JSON files; re-runnable.
# Encrypted stores migrate under the same SESSION_SECRET + MEDIKIOSK_ENCRYPT_PHI.

# Optional — scheduled backup interval in minutes (default 360 = every 6h; min 1).
# Snapshots land in <MEDIKIOSK_DATA_DIR>/backups with a SHA-256 sidecar (retention 7).
# MEDIKIOSK_BACKUP_INTERVAL_MIN=360

# Optional hardening — encrypt the encounter store at rest (AES-256-GCM, key
# derived from SESSION_SECRET). A wrong/missing secret fails loudly instead of
# silently corrupting data. Archived backups are encrypted the same way, and the
# restore drill verifies/decrypts them automatically. Keep OFF for plain-text
# demo datasets.
# MEDIKIOSK_ENCRYPT_PHI=1

# Optional hardening — use the "__Host-" session-cookie prefix (requires HTTPS;
# the Secure attribute is forced on). Leave unset for plain-http develop/CI.
# MEDIKIOSK_HOST_COOKIE_PREFIX=1

# Optional hardening — mark the session cookie Secure (HTTPS-only clients).
# Unlike the old NODE_ENV inference, this is the ONLY way Secure gets set, so a
# `next start --production` build served over plain http still logs in.
# __Host- prefix mode (MEDIKIOSK_HOST_COOKIE_PREFIX=1) forces Secure on anyway.
# MEDIKIOSK_SECURE_COOKIE=1

# Optional — trust X-Forwarded-For / X-Real-IP for rate limiting and login
# lockout keys, and X-Forwarded-Host / X-Forwarded-Proto for the CSRF
# same-origin check. Only set this when the server sits behind a reverse proxy
# that sanitizes those headers (nginx/caddy). Never set on a directly reachable
# host: clients could spoof their IP to dodge limits, or their own host so the
# CSRF check compares an attacker-chosen origin against itself.
# MEDIKIOSK_TRUST_PROXY=1

# Public origin(s) the app is served on, comma-separated — REQUIRED whenever
# browsers reach the app through a tunnel or reverse proxy (ngrok, localtunnel,
# Caddy, nginx). The server only ever sees its own Host (e.g. localhost:3000),
# so without this every browser POST (login, lookups, submissions, check-ins)
# fails CSRF with 403 while pages render fine. Operator-configured, never
# client-supplied, so unlike X-Forwarded-Host it cannot be spoofed.
# For tunnel demos: set this to the exact tunnel URL shown by the tool.
# MEDIKIOSK_PUBLIC_ORIGIN=https://kiosk.hospital.example

# API hardening — simple in-memory rate limiting (requests / window / burst).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000